upstream pins the exact Cython it builds release wheels with; any 3.1+
(freethreading_compatible directive) works

--- gssapi-1.12.0/pyproject.toml.orig
+++ gssapi-1.12.0/pyproject.toml
@@ -1,6 +1,6 @@
 [build-system]
 requires = [
-    "Cython == 3.3.0",
+    "Cython >= 3.1",
     "setuptools >= 40.6.0",  # Start of PEP 517 support for setuptools
 ]
 build-backend = "setuptools.build_meta"
